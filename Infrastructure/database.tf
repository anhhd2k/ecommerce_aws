###############################################################################
# RDS PostgreSQL
#
# Placed in the isolated private database tier (aws_db_subnet_group.main).
# Reachable only from the application tier on the PostgreSQL port; the DB
# subnets have no route to the internet.
#
# The master password is generated by Terraform (random_password) rather than
# read from a committed tfvars value, and the generated endpoint + password are
# pushed into SSM Parameter Store (see ssm.tf, which now references these).
###############################################################################

###############################################################################
# Security group: only the app tier may reach PostgreSQL
###############################################################################

resource "aws_security_group" "db" {
  name        = "${local.name_prefix}-db-sg"
  description = "PostgreSQL access from the application tier only."
  vpc_id      = aws_vpc.main.id

  tags = {
    Name = "${local.name_prefix}-db-sg"
  }
}

# Ingress: PostgreSQL from the private application subnets only.
resource "aws_security_group_rule" "db_ingress_from_app" {
  type              = "ingress"
  description       = "PostgreSQL from the application tier."
  from_port         = var.db_port
  to_port           = var.db_port
  protocol          = "tcp"
  security_group_id = aws_security_group.db.id
  cidr_blocks       = var.app_subnet_cidrs
}

# Egress: allow responses out (stateful SG; kept explicit for clarity).
resource "aws_security_group_rule" "db_egress_all" {
  type              = "egress"
  description       = "Allow all outbound."
  from_port         = 0
  to_port           = 0
  protocol          = "-1"
  security_group_id = aws_security_group.db.id
  cidr_blocks       = ["0.0.0.0/0"]
}

###############################################################################
# Generated master password
###############################################################################

resource "random_password" "db_master" {
  length  = 32
  special = true
  # RDS disallows these characters in the master password.
  override_special = "!#$%&*()-_=+[]{}<>:?"
}

###############################################################################
# RDS parameter group (PostgreSQL)
###############################################################################

resource "aws_db_parameter_group" "postgres" {
  name_prefix = "${local.name_prefix}-pg-"
  family      = var.db_parameter_group_family

  parameter {
    name  = "log_connections"
    value = "1"
  }

  lifecycle {
    create_before_destroy = true
  }

  tags = {
    Name = "${local.name_prefix}-pg-params"
  }
}

###############################################################################
# RDS PostgreSQL instance
###############################################################################

resource "aws_db_instance" "postgres" {
  identifier     = "${local.name_prefix}-postgres"
  engine         = "postgres"
  engine_version = var.db_engine_version
  instance_class = var.db_instance_class

  allocated_storage     = var.db_allocated_storage
  max_allocated_storage = var.db_max_allocated_storage
  storage_type          = "gp3"
  storage_encrypted     = true

  db_name  = var.db_name
  username = var.db_username
  password = random_password.db_master.result
  port     = var.db_port

  db_subnet_group_name   = aws_db_subnet_group.main.name
  vpc_security_group_ids = [aws_security_group.db.id]
  parameter_group_name   = aws_db_parameter_group.postgres.name

  # Isolated DB tier: never expose publicly.
  publicly_accessible = false

  multi_az                = var.db_multi_az
  backup_retention_period = var.db_backup_retention_period
  deletion_protection     = var.db_deletion_protection

  # In non-prod, allow destroy without a final snapshot for easy teardown.
  skip_final_snapshot       = var.environment != "prod"
  final_snapshot_identifier = var.environment == "prod" ? "${local.name_prefix}-postgres-final" : null

  apply_immediately = var.environment != "prod"

  tags = {
    Name = "${local.name_prefix}-postgres"
  }
}
